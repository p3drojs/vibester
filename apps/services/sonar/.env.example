# Copie para `.env` (ignorado pelo git) e preencha.
#
# Token gerado em http://localhost:9001 -> My Account -> Security -> Generate
# Tokens. Escolha o tipo "Global Analysis Token" para conseguir analisar todos
# os servicos com o mesmo token.
SONAR_TOKEN=

# Senha do Postgres interno do Sonar. Opcional -- o compose usa "sonar" por
# padrao. Este banco nao expoe porta no host.
# SONAR_DB_PASSWORD=sonar

# Porta do host onde o SonarQube do Vibester escuta. Default 9001 (a 9000
# costuma estar ocupada por outra instancia local).
# SONAR_PORT=9001
